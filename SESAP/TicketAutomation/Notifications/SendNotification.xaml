<Activity mc:Ignorable="sap sap2010" x:Class="SendNotification" mva:VisualBasic.Settings="{x:Null}"
xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=mscorlib"
xmlns:ui="http://schemas.uipath.com/workflow/activities"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Members>
        <x:Property Name="in_Ref" Type="InArgument(x:String)" />
        <x:Property Name="in_RecipientEmail" Type="InArgument(x:String)" />
        <x:Property Name="in_RecipientName" Type="InArgument(x:String)" />
        <x:Property Name="in_NotificationType" Type="InArgument(x:String)" />
        <x:Property Name="in_Subject" Type="InArgument(x:String)" />
        <x:Property Name="out_Sent" Type="OutArgument(x:Boolean)" />
        <x:Property Name="out_MessageBody" Type="OutArgument(x:String)" />
    </x:Members>
    <TextExpression.NamespacesForImplementation>
        <sco:Collection x:TypeArguments="x:String">
            <x:String>System.Activities</x:String>
            <x:String>System.Activities.Statements</x:String>
            <x:String>Microsoft.VisualBasic</x:String>
            <x:String>Microsoft.VisualBasic.Activities</x:String>
            <x:String>System</x:String>
            <x:String>System.Collections.Generic</x:String>
            <x:String>System.Linq</x:String>
        </sco:Collection>
    </TextExpression.NamespacesForImplementation>
    <TextExpression.ReferencesForImplementation>
        <sco:Collection x:TypeArguments="AssemblyReference">
            <AssemblyReference>System.Activities</AssemblyReference>
            <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
            <AssemblyReference>System.Private.CoreLib</AssemblyReference>
            <AssemblyReference>mscorlib</AssemblyReference>
            <AssemblyReference>System</AssemblyReference>
            <AssemblyReference>System.Linq</AssemblyReference>
            <AssemblyReference>UiPath.System.Activities</AssemblyReference>
        </sco:Collection>
    </TextExpression.ReferencesForImplementation>
    <Sequence DisplayName="Send Notification" sap2010:WorkflowViewState.IdRef="Sequence_Notify">
        <sap2010:WorkflowViewState.ViewStateManager>
            <sap2010:ViewStateManager />
        </sap2010:WorkflowViewState.ViewStateManager>
        <Assign sap2010:WorkflowViewState.IdRef="Assign_Body">
            <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_MessageBody]</OutArgument>
            </Assign.To>
            <Assign.Value>
                <InArgument x:TypeArguments="x:String">[&quot;Hello &quot; + in_RecipientName + &quot;,&quot; + Environment.NewLine + Environment.NewLine + &quot;Notification (&quot; + in_NotificationType + &quot;) for ticket &quot; + in_Ref + &quot;: &quot; + in_Subject + Environment.NewLine + Environment.NewLine + &quot;Please review this ticket in SESAP.&quot; + Environment.NewLine + &quot;- SESAP Automated Notification&quot;]</InArgument>
            </Assign.Value>
        </Assign>
        <If Condition="[Not String.IsNullOrWhiteSpace(in_RecipientEmail)]" sap2010:WorkflowViewState.IdRef="If_HasEmail">
            <If.Then>
                <Sequence DisplayName="Dispatch" sap2010:WorkflowViewState.IdRef="Sequence_Dispatch">
                    <ui:LogMessage sap2010:WorkflowViewState.IdRef="Log_Notify" Level="Info" Message="[&quot;[NOTIFY] to=&quot; + in_RecipientEmail + &quot; type=&quot; + in_NotificationType + &quot; ref=&quot; + in_Ref + &quot; | body prepared (&quot; + out_MessageBody.Length.ToString() + &quot; chars). To enable live email, add a Send Mail activity + mail connection here.&quot;]" />
                    <Assign sap2010:WorkflowViewState.IdRef="Assign_SentTrue">
                        <Assign.To>
                            <OutArgument x:TypeArguments="x:Boolean">[out_Sent]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                            <InArgument x:TypeArguments="x:Boolean">True</InArgument>
                        </Assign.Value>
                    </Assign>
                </Sequence>
            </If.Then>
            <If.Else>
                <Sequence DisplayName="No Recipient" sap2010:WorkflowViewState.IdRef="Sequence_NoRecipient">
                    <ui:LogMessage sap2010:WorkflowViewState.IdRef="Log_NoRecipient" Level="Warn" Message="[&quot;[NOTIFY] skipped - no recipient for &quot; + in_Ref]" />
                    <Assign sap2010:WorkflowViewState.IdRef="Assign_SentFalse">
                        <Assign.To>
                            <OutArgument x:TypeArguments="x:Boolean">[out_Sent]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                            <InArgument x:TypeArguments="x:Boolean">False</InArgument>
                        </Assign.Value>
                    </Assign>
                </Sequence>
            </If.Else>
        </If>
    </Sequence>
</Activity>
